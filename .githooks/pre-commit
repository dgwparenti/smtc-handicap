#!/usr/bin/env bash
set -euo pipefail

# Activate venv if present (ruff is installed there)
REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
if [ -f "$REPO_DIR/.venv/bin/activate" ]; then
    source "$REPO_DIR/.venv/bin/activate"
fi

# Get staged Python files (excluding deleted files)
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=d -- '*.py')

if [ -z "$STAGED_PY_FILES" ]; then
    exit 0
fi

echo "Running ruff format on staged Python files..."
echo "$STAGED_PY_FILES" | xargs ruff format

# Re-stage the formatted files
echo "$STAGED_PY_FILES" | xargs git add

echo "Pre-commit formatting done."
